{
  "name": "chozem",
  "productName": "Chozem",
  "version": "0.1.5-beta",
  "description": "A minimal browser where everything is a plugin.",
  "main": "main/main.js",
  "author": "Chozem",
  "license": "MIT",
  "homepage": "https://github.com/chozem/chozem",
  "scripts": {
    "start": "node tools/start.js",
    "dev": "node tools/start.js --dev",
    "shot": "node tools/start.js --shot --disable-gpu --no-sandbox --in-process-gpu --disable-gpu-sandbox",
    "plugin:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-plugin.ps1",
    "dist": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux deb --x64",
    "dist:linux:arm64": "electron-builder --linux deb --arm64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chozem.browser",
    "productName": "Chozem",
    "copyright": "Copyright © 2026 Chozem contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "ui/**/*",
      "plugins/**/*",
      "SKILL.md",
      "README.md",
      "LICENSE",
      "package.json",
      "!**/*.map",
      "!**/.design/**",
      "!**/examples/**"
    ],
    "win": {
      "icon": "ui/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chozem-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chozem",
      "uninstallDisplayName": "Chozem",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icons",
      "maintainer": "Chozem <chozem@users.noreply.github.com>",
      "synopsis": "A minimal browser where everything is a plugin",
      "description": "Chozem is a minimal browser whose tabs, start page, settings, downloads and cookie manager are all built-in plugins. The kernel only owns windows, web views, sessions and plugin loading.",
      "artifactName": "Chozem_${version}_${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Chozem",
          "Comment": "A minimal browser where everything is a plugin",
          "Categories": "Network;WebBrowser;"
        }
      }
    }
  }
}
